# Copy to .env and fill in real values. NEVER commit .env.
# The Anthropic key does NOT go here — set it as a Supabase secret:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: product analytics + telemetry endpoints (leave unset to disable)
# VITE_ANALYTICS_ENDPOINT=https://your-analytics-collector.example.com/events
# VITE_TELEMETRY_ENDPOINT=https://your-telemetry-collector.example.com/events

# Hospital billing (server-side / dashboard only — never prefix with VITE_)
# STRIPE_SECRET_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
